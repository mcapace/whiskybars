# Mapbox (required for map and geocoding)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Google Sheets - Whisky Bars master list (must be published or "Anyone with link" can view)
# Master: https://docs.google.com/spreadsheets/d/1mRQOw07ofPAK-Vwak0MGcT2qjnEgWZjNB9w6gW_1B0w/edit?gid=0
# Either URL format works for CSV:
#   gviz (current): .../gviz/tq?tqx=out:csv
#   export: .../export?format=csv&gid=0
NEXT_PUBLIC_SHEETS_URL=https://docs.google.com/spreadsheets/d/1mRQOw07ofPAK-Vwak0MGcT2qjnEgWZjNB9w6gW_1B0w/gviz/tq?tqx=out:csv
